# Copy this file to .env and fill in your values.

# GitHub Personal Access Token. A fine-grained token with
# "Pull requests: read & write" lets you read private PRs and post comments.
# Optional if you're logged in with the gh CLI (`gh auth login`): PR Studio
# falls back to gh's stored token. Without either, you can browse public PRs
# read-only.
GITHUB_TOKEN=

# Optional. A local clone the agent works in when you haven't set a per-PR
# path in the UI. Absolute path, e.g. /Users/you/code/my-repo
DEFAULT_REPO_PATH=

# Optional. Port the server listens on (default 4317).
PORT=4317

# Optional. Override the Claude Code binary name/path if "claude" isn't on PATH.
CLAUDE_BIN=claude
